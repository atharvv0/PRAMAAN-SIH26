APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=pramaan
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=Atharvv0
DATABASE_URL=

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Local AI Runtime - Ollama
MODEL_RUNTIME=ollama
MODEL_RUNTIME_HOST=127.0.0.1
MODEL_RUNTIME_PORT=11434

REASONING_MODEL_NAME=qwen3:4b
CODING_MODEL_NAME=qwen3:4b
OCR_MODEL_NAME=gemma3:4b
VISION_MODEL_NAME=gemma3:4b
EMBEDDING_MODEL_NAME=nomic-embed-text

# Sandbox
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=1024

# Security / Network Policy
EGRESS_POLICY=deny-all
NETWORK_MONITOR_ENABLED=true

# Authentication
JWT_SECRET=dev-only-change-me
JWT_EXPIRY_MINUTES=60

# Frontend -> Backend
VITE_API_MODE=http
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Planner
PLANNER_CONTEXT_LENGTH=4096

# Ollama Offline / Local-only Configuration
OLLAMA_NO_CLOUD=1
OLLAMA_MAX_TRANSFER_STREAMS=1
OLLAMA_MODELS=D:\OllamaModels

# Qdrant / Embeddings
USE_QDRANT_SERVER=1
USE_OLLAMA_EMBEDDINGS=1