# ---- Environment / secrets ----
.env
*.env.local
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- Node / Frontend ----
node_modules/
dist/
build/
.next/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Docker ----
*.pid

# ---- Models / vector data / large artifacts ----
*.gguf
*.safetensors
*.bin
data/vectorstore/*
