# Browser-facing API base. Keep this relative when using the Vite dev proxy or production reverse proxy.
VITE_API_BASE_URL=/api/v1

# Development-only backend target used by Vite's local proxy.
# This is not embedded in the application bundle.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

VITE_APP_NAME=PRAMAAN
