# PRAMAAN local service configuration
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pramaan
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=changeme
# DATABASE_URL=postgresql+psycopg://pramaan:changeme@localhost:5433/pramaan

QDRANT_HOST=localhost
QDRANT_PORT=6333
USE_QDRANT_SERVER=1

OLLAMA_HOST=localhost
OLLAMA_PORT=11434
REASONING_MODEL_NAME=qwen3:4b
SUMMARIZE_MODEL_NAME=qwen3:4b
CODING_MODEL_NAME=qwen3:4b
VISION_MODEL_NAME=gemma3:4b
OCR_MODEL_NAME=gemma3:4b
EMBEDDING_MODEL_NAME=nomic-embed-text

AUTO_DISCOVER_OLLAMA_MODELS=1
OLLAMA_NO_CLOUD=1

# Local development only. Replace with verified JWT/OIDC auth in production.
JWT_SECRET=changeme
JWT_EXPIRY_MINUTES=60
